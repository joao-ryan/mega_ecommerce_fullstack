# VITE_API_URL: Base URL for E-commerce REST API
VITE_API_URL="https://mega-ecommerce-fullstack.onrender.com/api"

# VITE_CLERK_PUBLISHABLE_KEY: Optional Clerk Publishable Key (https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=
